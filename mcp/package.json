{
  "name": "@filestack/mcp",
  "version": "1.0.0",
  "description": "Filestack MCP server — exposes Filestack API as Claude Code tools",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/filestack/filestack-claude-plugin"
  },
  "keywords": ["filestack", "mcp", "claude-code", "file-upload", "cdn"],
  "author": {
    "name": "Filestack",
    "email": "support@filestack.com"
  },
  "main": "dist/index.js",
  "bin": {
    "filestack-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/bundle.js --external:filestack-js",
    "test": "jest",
    "test:integration": "FILESTACK_INTEGRATION=1 jest tests/integration",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "filestack-js": "^3.41.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.0",
    "jest": "^29.0.0",
    "nock": "^13.5.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  }
}
